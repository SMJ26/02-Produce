{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presetVersion", "fps", "width", "height", "sampleRate", "durationFrames", "assets", "video", "overlays", "audio"],
  "properties": {
    "version": {"const": 1},
    "presetVersion": {"type": "string", "minLength": 1},
    "fps": {"const": 30},
    "width": {"const": 1920},
    "height": {"const": 1080},
    "sampleRate": {"const": 48000},
    "durationFrames": {"type": "integer", "minimum": 1, "maximum": 450000},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "licenseId", "kind"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "licenseId": {"type": "string"},
          "kind": {"enum": ["video", "image", "audio", "words", "font"]}
        }
      }
    },
    "video": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clip"}},
    "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}},
    "audio": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/audio"}}
  },
  "$defs": {
    "index": {"type": "integer", "minimum": 0},
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "assetId", "sourceIn", "transition", "fit"],
      "properties": {
        "start": {"$ref": "#/$defs/index"}, "end": {"$ref": "#/$defs/index"},
        "assetId": {"type": "string"}, "sourceIn": {"$ref": "#/$defs/index"},
        "transition": {"enum": ["cut", "dissolve"]},
        "transitionFrames": {"type": "integer", "minimum": 0, "maximum": 30},
        "fit": {"enum": ["cover", "contain"]},
        "motion": {"enum": ["static", "push", "pan"]}
      }
    },
    "overlay": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "kind", "z", "text"],
      "properties": {
        "start": {"$ref": "#/$defs/index"}, "end": {"$ref": "#/$defs/index"},
        "kind": {"enum": ["caption", "chapter", "name", "number"]},
        "z": {"type": "integer", "minimum": 1, "maximum": 10},
        "text": {"type": "string", "maxLength": 240},
        "anchorWordId": {"type": "string"},
        "wordIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "role", "startSample", "endSample", "inSample", "gainDb"],
      "properties": {
        "assetId": {"type": "string"}, "role": {"enum": ["narration", "music", "sfx"]},
        "startSample": {"$ref": "#/$defs/index"}, "endSample": {"$ref": "#/$defs/index"},
        "inSample": {"$ref": "#/$defs/index"},
        "gainDb": {"type": "number", "minimum": -90, "maximum": 12}
      }
    }
  }
}
